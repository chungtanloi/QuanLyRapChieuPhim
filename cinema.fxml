<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="433.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cinema.controller.CinemaController">
   <children>
      <VBox layoutX="14.0" layoutY="5.0" prefHeight="548.0" prefWidth="875.0" spacing="20" styleClass="main-content">
         <padding>
            <Insets bottom="20" left="30" right="30" top="20" />
         </padding>
         <children>
            <Button mnemonicParsing="false" text="Thêm rạp mới" />
            <HBox alignment="CENTER" spacing="20">
               <children>
                  <VBox spacing="5" styleClass="stat-card, stat-blue" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="stat-label" text="Tổng số rạp" />
                        <Label fx:id="totalTheatersLabel" styleClass="stat-value" text="0" />
                     </children>
                  </VBox>
                  <VBox spacing="5" styleClass="stat-card, stat-green" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="stat-label" text="Đang hoạt động" />
                        <Label fx:id="activeTheatersLabel" styleClass="stat-value" text="0" />
                     </children>
                  </VBox>
                  <VBox spacing="5" styleClass="stat-card, stat-yellow" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="stat-label" text="Đang bảo trì" />
                        <Label fx:id="maintenanceTheatersLabel" styleClass="stat-value" text="0" />
                     </children>
                  </VBox>
                  <VBox spacing="5" styleClass="stat-card, stat-purple" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="stat-label" text="Tổng ghế ngồi" />
                        <Label fx:id="totalSeatsLabel" styleClass="stat-value" text="0" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="theaterTable" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="nameColumn" prefWidth="200" text="Tên Rạp" />
                        <TableColumn fx:id="seatsColumn" prefWidth="100" text="Số Ghế" />
                        <TableColumn fx:id="screenTypeColumn" prefWidth="150" text="Loại Màn Hình" />
                        <TableColumn fx:id="statusColumn" prefWidth="172.00003051757812" text="Trạng Thái" />
                        <TableColumn fx:id="actionsColumn" prefWidth="191.199951171875" text="Thao Tác" />
                     </columns>
                     <placeholder>
                        <VBox alignment="CENTER" spacing="10">
                           <children>
                              <Label style="-fx-font-size: 48px; -fx-opacity: 0.3;" text="🎬" />
                              <Label styleClass="empty-message" text="Chưa có rạp chiếu nào" />
                              <Label styleClass="empty-submessage" text="Nhấn 'Thêm Rạp Mới' để bắt đầu" />
                           </children>
                        </VBox>
                     </placeholder>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
