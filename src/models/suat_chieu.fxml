<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: #f0f4f7;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.suat_chieuController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <top>
        <VBox spacing="10">
            <VBox styleClass="section-panel">
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #37474f;" text="QUẢN LÝ SUẤT CHIẾU">
                        <font>
                            <Font size="24.0" />
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnThemSuatChieu" mnemonicParsing="false" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" text="+ Thêm Mới" />
                </HBox>
            </VBox>
            
            <VBox styleClass="section-panel" spacing="10">
                <children>
                    <Label text="BỘ LỌC TÌM KIẾM" style="-fx-font-weight: bold;" />
                    <HBox spacing="10" alignment="BOTTOM_LEFT">
                        <DatePicker fx:id="dpLichChieu" prefWidth="150.0" promptText="Lọc theo ngày" />
                        <ComboBox fx:id="cbPhimFilter" prefWidth="200.0" promptText="Lọc theo phim" />
                        <Region HBox.hgrow="ALWAYS" />
                        </HBox>
                </children>
                 <VBox.margin>
                    <Insets top="15.0" />
                 </VBox.margin>
            </VBox>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="10" styleClass="section-panel" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="section-title" text="DANH SÁCH SUẤT CHIẾU">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <TableView fx:id="tblSuatChieu" prefHeight="300.0" style="-fx-border-color: #ddd;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMaSuat" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colTenPhimSC" prefWidth="200.0" text="Tên Phim" />
                        <TableColumn fx:id="colPhongChieu" prefWidth="120.0" text="Phòng" />
                        <TableColumn fx:id="colDinhDang" prefWidth="80.0" text="Định Dạng" />
                        <TableColumn fx:id="colNgayChieu" prefWidth="120.0" text="Ngày Chiếu" />
                        <TableColumn fx:id="colGioChieu" prefWidth="100.0" text="Giờ Chiếu" />
                        <TableColumn fx:id="colGiaVe" prefWidth="100.0" text="Giá (VNĐ)" />
                        <TableColumn fx:id="colTrangThaiSC" prefWidth="100.0" text="Trạng Thái" />
                    </columns>
                    
                </TableView>
                 <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button fx:id="btnSuaSuatChieu" mnemonicParsing="false" styleClass="btn-action, btn-blue" text="Sửa Suất Chiếu" />
                    <Button fx:id="btnXoaSuatChieu" mnemonicParsing="false" styleClass="btn-action, btn-grey" text="Xóa Suất Chiếu" />
                </HBox>
            </children>
             <BorderPane.margin>
                <Insets top="15.0" />
             </BorderPane.margin>
        </VBox>
    </center>
    
    </BorderPane>