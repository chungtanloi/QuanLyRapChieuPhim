<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root" prefHeight="700" prefWidth="1000" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.QLKhuyenMaiController">

    <!-- TOP: HEADER -->
    <top>
        <HBox spacing="20" style="-fx-background-color: #7e22ce; -fx-alignment: CENTER_LEFT;">
            <children>
                <Label text="🎁 QUẢN LÝ KHUYẾN MÃI" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />
                <Pane HBox.hgrow="ALWAYS" />
                <Button fx:id="btnThemKM" text="➕ Thêm KM" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
            </children>
            <padding>
                <Insets bottom="12" left="15" right="15" top="12" />
            </padding>
        </HBox>
    </top>

    <!-- CENTER: CONTENT -->
    <center>
        <VBox spacing="15" style="-fx-padding: 15; -fx-background-color: #f8fafc;">
            <children>
                <!-- FILTER BAR -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <TextField fx:id="txtTimKM" promptText="Tìm mã khuyến mãi..." prefWidth="200" style="-fx-background-radius: 5;" />
                        <ComboBox fx:id="cbLoaiKM" promptText="Loại KM" prefWidth="120" style="-fx-background-radius: 5;" />
                        <ComboBox fx:id="cbTrangThaiKM" promptText="Trạng thái" prefWidth="120" style="-fx-background-radius: 5;" />
                        <Button fx:id="btnTimKiem" text="🔍 Tìm" style="-fx-background-color: #4b5563; -fx-text-fill: white; -fx-background-radius: 5;" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <Label text="Tổng: " style="-fx-font-weight: bold;" />
                        <Label fx:id="lblTongKM" text="0 KM" style="-fx-text-fill: #7e22ce; -fx-font-weight: bold;" />
                    </children>
                </HBox>

                <!-- TABLE -->
                <TableView fx:id="tblKhuyenMai" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8; -fx-border-radius: 8;">
                    <columns>
                        <TableColumn fx:id="colMaKM" prefWidth="120" text="Mã KM" />
                        <TableColumn fx:id="colLoaiGiam" prefWidth="100" text="Loại giảm" />
                        <TableColumn fx:id="colMucGiam" prefWidth="120" text="Mức giảm" />
                        <TableColumn fx:id="colDonToiThieu" prefWidth="130" text="Đơn tối thiểu" />
                        <TableColumn fx:id="colThoiGianKM" prefWidth="200" text="Thời gian" />
                        <TableColumn fx:id="colTrangThaiKM" prefWidth="120" text="Trạng thái" />
                        <TableColumn fx:id="colActionKM" prefWidth="150" text="Thao tác" />
                    </columns>
                </TableView>

                <!-- FORM THÊM/ SỬA -->
                <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-width: 1; -fx-border-radius: 8;">
                    <children>
                        <Label text="📝 THÔNG TIN KHUYẾN MÃI" style="-fx-text-fill: #1f2937; -fx-font-size: 18px; -fx-font-weight: bold;" />
                        
                        <GridPane hgap="10" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="120" />
                                <ColumnConstraints prefWidth="250" />
                                <ColumnConstraints prefWidth="120" />
                                <ColumnConstraints prefWidth="250" />
                            </columnConstraints>
                            <children>
                                <Label text="Mã KM:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                                <TextField fx:id="txtMaKM" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-background-radius: 5;" />
                                
                                <Label text="Loại giảm:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                                <ComboBox fx:id="cbKieuGiam" GridPane.rowIndex="0" GridPane.columnIndex="3" style="-fx-background-radius: 5;" />
                                
                                <Label text="Mức giảm:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                                <TextField fx:id="txtMucGiam" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-background-radius: 5;" />
                                
                                <Label text="Đơn tối thiểu:" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                                <TextField fx:id="txtDonToiThieu" GridPane.rowIndex="1" GridPane.columnIndex="3" style="-fx-background-radius: 5;" />
                                
                                <Label text="Bắt đầu:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                                <DatePicker fx:id="dpBatDau" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-background-radius: 5;" />
                                
                                <Label text="Kết thúc:" GridPane.rowIndex="2" GridPane.columnIndex="2" />
                                <DatePicker fx:id="dpKetThuc" GridPane.rowIndex="2" GridPane.columnIndex="3" style="-fx-background-radius: 5;" />
                                
                                <Label text="Trạng thái:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                                <ComboBox fx:id="cbStatusKM" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-background-radius: 5;" />
                            </children>
                        </GridPane>

                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <children>
                                <Button fx:id="btnHuy" text="❌ Hủy" style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-background-radius: 5;" />
                                <Button fx:id="btnLuu" text="💾 Lưu" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>

</BorderPane>