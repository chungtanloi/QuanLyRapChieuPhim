<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root" prefHeight="700" prefWidth="1000" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.QLSanPhamController">

    <!-- TOP: HEADER -->
    <top>
        <HBox spacing="20" style="-fx-background-color: #e63946; -fx-alignment: CENTER_LEFT;">
            <children>
                <Label text="🍿 QUẢN LÝ SẢN PHẨM (COMBO)" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />
                <Pane HBox.hgrow="ALWAYS" />
                <Button fx:id ="btnThemCombo" text="➕ Thêm Combo" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold;" />
            </children>
            <padding>
                <Insets bottom="12" left="15" right="15" top="12" />
            </padding>
        </HBox>
    </top>

    <!-- CENTER: CONTENT -->
    <center>
        <SplitPane dividerPositions="0.6" style="-fx-background-color: #f8fafc;">
            <items>
                <!-- LEFT: DANH SÁCH COMBO -->
                <VBox spacing="10" style="-fx-padding: 15;">
                    <children>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <children>
                                <TextField fx:id="txtTimCombo" promptText="Tìm combo..." prefWidth="250" />
                                <Button fx:id="btnTimKiem" text="🔍 Tìm" style="-fx-background-color: #6b7280; -fx-text-fill: white;" />
                                <Pane HBox.hgrow="ALWAYS" />
                                <Label text="Tổng: " style="-fx-font-weight: bold;" />
                                <Label fx:id="lblTongCombo" text="0 combo" style="-fx-text-fill: #e63946; -fx-font-weight: bold;" />
                            </children>
                        </HBox>

                        <TableView fx:id="tblCombo" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colMaCombo" prefWidth="80" text="Mã" />
                                <TableColumn fx:id="colTenCombo" prefWidth="200" text="Tên Combo" />
                                <TableColumn fx:id="colGiaCombo" prefWidth="120" text="Giá" />
                                <TableColumn fx:id="colTrangThaiCombo" prefWidth="100" text="Trạng thái" />
                                <TableColumn fx:id="colActionCombo" prefWidth="150" text="Thao tác" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>

                <!-- RIGHT: CHI TIẾT COMBO -->
                <VBox spacing="15" style="-fx-padding: 15; -fx-background-color: white;">
                    <children>
                        <Label text="📦 CHI TIẾT COMBO" style="-fx-text-fill: #111827; -fx-font-size: 18px; -fx-font-weight: bold;" />
                        
                        <GridPane hgap="10" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="100" />
                                <ColumnConstraints prefWidth="250" />
                            </columnConstraints>
                            <children>
                                <Label text="Tên combo:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                                <TextField fx:id="txtTenCombo" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                                
                                <Label text="Giá:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                                <TextField fx:id="txtGiaCombo" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                                
                                <Label text="Mô tả:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                                <TextArea fx:id="txtMoTaCombo" prefRowCount="3" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                                
                                <Label text="Trạng thái:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                                <ComboBox fx:id="cbTrangThaiCombo" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                            </children>
                        </GridPane>

                        <!-- DANH SÁCH SẢN PHẨM TRONG COMBO -->
                        <Label text="🛒 Sản phẩm trong combo:" style="-fx-font-weight: bold;" />
                        <!-- Các nút Thêm và Sửa sản phẩm trong combo -->
<HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
    <children>
        <Button fx:id="btnThemSanPham" text="➕ Thêm" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold;" />
        <Button fx:id="btnSuaSanPham" text="✏️ Sửa" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold;" />
    </children>
</HBox>
                        <TableView fx:id="tblSanPhamTrongCombo" prefHeight="200">
                            <columns>
                                <TableColumn fx:id="colTenSP" prefWidth="150" text="Sản phẩm" />
                                <TableColumn fx:id="colSoLuongSP" prefWidth="80" text="Số lượng" />
                                <TableColumn fx:id="colGiaSP" prefWidth="100" text="Giá" />
                                <TableColumn fx:id="colActionSP" prefWidth="80" text="Xóa" />
                            </columns>
                        </TableView>

                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <children>
                                <Button fx:id="btnHuy" text="❌ Hủy" style="-fx-background-color: #ef4444; -fx-text-fill: white;" />
                                <Button fx:id="btnLuu" text="💾 Lưu" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold;" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>

</BorderPane>