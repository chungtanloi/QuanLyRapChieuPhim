<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.BillController"
            prefWidth="950" prefHeight="600">

    <children>

        <!-- Tiêu đề -->
        <Label text="📋 Quản Lý Hóa Đơn"
               layoutX="20" layoutY="15"
               style="-fx-font-size:22px; -fx-font-weight:bold;"/>

        

        <Label text="Từ:" layoutX="170" layoutY="65"/>
        <DatePicker fx:id="dpFrom" layoutX="200" layoutY="60" prefWidth="120"/>

        <Label text="Đến:" layoutX="330" layoutY="65"/>
        <DatePicker fx:id="dpTo" layoutX="365" layoutY="60" prefWidth="120"/>

        <ComboBox fx:id="cboTrangThai"
                  layoutX="495" layoutY="60"
                  prefWidth="130"/>

        <TextField fx:id="txtTimKiem"
                   layoutX="635" layoutY="60"
                   prefWidth="220"
                   promptText="Tìm theo mã, tên khách, nhân viên..."/>

        <Button text="Tìm kiếm"
                layoutX="865" layoutY="60"
                onAction="#handleTimKiem"/>

        <!-- Nhãn thống kê -->
        <HBox layoutX="20" layoutY="100" spacing="40">
            <children>
                <Label text="Tổng hóa đơn:"/>
                <Label fx:id="lblTongHoaDon" text="0"
                       style="-fx-font-weight:bold;"/>
                <Label text="Tổng doanh thu:"/>
                <Label fx:id="lblTongDoanhThu"
                       text="0 đ"
                       style="-fx-font-weight:bold; -fx-text-fill:green;"/>
            </children>
        </HBox>

        <!-- Bảng danh sách -->
        <TableView fx:id="tblHoaDon"
                   layoutX="20" layoutY="140"
                   prefWidth="900" prefHeight="420">

            <columns>
                <TableColumn fx:id="colMaHD"
                             text="Mã HĐ" prefWidth="70"/>

                <TableColumn fx:id="colNgay"
                             text="Ngày tạo" prefWidth="140"/>

                <TableColumn fx:id="colKhach"
                             text="Khách hàng" prefWidth="160"/>

                <TableColumn fx:id="colNhanVien"
                             text="Nhân viên" prefWidth="140"/>

                <TableColumn fx:id="colTongTien"
                             text="Tổng tiền" prefWidth="130"/>

                <TableColumn fx:id="colTrangThai"
                             text="Trạng thái" prefWidth="110"/>

                <TableColumn fx:id="colThaoTac"
                             text="Thao tác" prefWidth="150"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>
