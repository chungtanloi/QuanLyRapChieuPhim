<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="712.0" prefWidth="812.0" style="-fx-background-color: #f0f4f7;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.PhimController">

    <top>
        <VBox spacing="10">

            <!-- TIÊU ĐỀ -->
            <VBox styleClass="section-panel">
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <Label text="QUẢN LÝ THÔNG TIN PHIM">
                        <font>
                            <Font size="24.0"/>
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnThemPhim" text="+ Thêm Mới" style="-fx-background-color: #4CAF50; -fx-text-fill:white;"
                            onAction="#handleThemMoi"/>
                </HBox>
            </VBox>

            <!-- BỘ LỌC -->
            <VBox spacing="10" styleClass="section-panel">
                <children>
                    <Label text="BỘ LỌC TÌM KIẾM" style="-fx-font-weight:bold;"/>
                    <GridPane hgap="10" vgap="10">

                        <children>
                            <TextField fx:id="txtTimKiemPhim" promptText="Tìm theo tên phim..." GridPane.columnIndex="0"/>

                            <ComboBox fx:id="cbLocTheoTheLoai" promptText="Lọc theo thể loại" GridPane.columnIndex="1"/>
                            <ComboBox fx:id="cbLocTheoPhanLoai" promptText="Lọc theo phân loại" GridPane.columnIndex="2"/>

                            <DatePicker fx:id="dpTuNgay" promptText="Từ ngày" GridPane.columnIndex="3"/>
                            <DatePicker fx:id="dpDenNgay" promptText="Đến ngày" GridPane.columnIndex="4"/>

                            <HBox spacing="15" GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="1">
                                <children>
                                    <CheckBox fx:id="chkDangChieu" text="Đang chiếu"/>
                                    <CheckBox fx:id="chkSapChieu" text="Sắp chiếu"/>
                                </children>
                            </HBox>

                            <Button fx:id="btnTimKiem" text="Tìm kiếm" GridPane.columnIndex="4" GridPane.rowIndex="1"
                                    onAction="#handleTimKiem"/>
                        </children>
                    </GridPane>
                </children>
            </VBox>

        </VBox>
    </top>

    <!-- BẢNG PHIM -->
    <center>
        <VBox spacing="10" styleClass="section-panel">
            <children>
                <Label text="DANH SÁCH PHIM" styleClass="section-title"/>

                <TableView fx:id="tblPhim">
                    <columns>
                        <TableColumn fx:id="colMaPhim" text="ID"/>
                        <TableColumn fx:id="colTenPhim" text="Tên Phim"/>
                        <TableColumn fx:id="colThoiLuong" text="Thời Lượng"/>
                        <TableColumn fx:id="colTheLoai" text="Thể Loại"/>
                        <TableColumn fx:id="colPhanLoai" text="Phân Loại"/>
                        <TableColumn fx:id="colNgayPhatHanh" text="Ngày KC"/>
                        <TableColumn fx:id="colTrangThai" text="Trạng Thái"/>
                    </columns>
                </TableView>

                <HBox spacing="10">
                    <Button fx:id="btnSuaPhim" text="Sửa Phim Đã Chọn" onAction="#handleSuaPhim"/>
                    <Button fx:id="btnXoaPhim" text="Xóa Phim Đã Chọn" onAction="#handleXoaPhim"/>
                </HBox>
            </children>
        </VBox>
    </center>

    <!-- PHẦN CHI TIẾT -->
    <bottom>
        <VBox spacing="10" styleClass="section-panel">
            <children>

                <Label text="THÔNG TIN CHI TIẾT PHIM"
                       style="-fx-font-weight:bold; -fx-text-fill:#4CAF50;">
                    <font>
                        <Font size="18"/>
                    </font>
                </Label>

                <HBox spacing="20">

                    <!-- POSTER -->
                    <VBox spacing="10" alignment="TOP_CENTER">
                        <children>
                            <ImageView fx:id="imgPhimPoster" fitHeight="250" fitWidth="180">
                                <image>
                                    <Image url="@../Application/image/cinema.png"/>
                                </image>
                            </ImageView>
                            <Button fx:id="btnUploadPoster"
                                    mnemonicParsing="false"
                                    text="Tải ảnh lên"
                                    onAction="#handleUploadPoster" />

                        </children>
                    </VBox>

                    <!-- FORM CHI TIẾT MỚI -->
                    <VBox HBox.hgrow="ALWAYS">

                        <GridPane hgap="15" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="100"/>
                                <ColumnConstraints prefWidth="200"/>
                                <ColumnConstraints prefWidth="100"/>
                                <ColumnConstraints prefWidth="200"/>
                            </columnConstraints>
                            <children>

                                <!-- Hàng 1 -->
                                <Label text="Mã Phim:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtMaPhim" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Tên Phim:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                <TextField fx:id="txtTenPhim" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                                <!-- Hàng 2 -->
                                <Label text="Thời Lượng:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtThoiLuong" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Thể Loại:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                <TextField fx:id="txtTheLoai" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                                <!-- Hàng 3 -->
                                <Label text="Phân Loại:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtPhanLoai" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label text="Ngày Khởi Chiếu:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                                <TextField fx:id="txtNgayKhoiChieu" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                            </children>
                        </GridPane>

                        <Label text="Mô Tả:"/>
                        <TextArea fx:id="txtMoTa" prefHeight="80"/>

                        <HBox alignment="CENTER" spacing="15">
                            <children>
                                <Button fx:id="btnLamMoi" text="Làm Mới" onAction="#handleLamMoi"/>
                                <Button fx:id="btnLuu" text="💾 Lưu" onAction="#handleLuuPhim"/>
                                <Button fx:id="btnXoa" text="Xóa" onAction="#handleXoaPhim"/>
                            </children>
                        </HBox>
                    </VBox>

                </HBox>
            </children>
        </VBox>
    </bottom>

</BorderPane>
