<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.BaoCaoController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="BÁO CÁO DANH SÁCH PHIM THEO NGÀY" textFill="#1a237e">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Chọn Ngày Chiếu:" />
        <DatePicker fx:id="dpNgayBaoCao" promptText="Ngày báo cáo" />
        <Button fx:id="btnXemBaoCao" text="Xem Báo Cáo" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
    </HBox>

    <Label fx:id="lblTongThoiGian" text="Tổng thời lượng phim chiếu trong ngày: 0 giờ 0 phút" textFill="#e91e63">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>
    </Label>

    <TableView fx:id="tblBaoCao" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTenPhim" prefWidth="350.0" text="Tên Phim" />
            <TableColumn fx:id="colTongSuat" prefWidth="150.0" text="Tổng Suất Chiếu" />
            <TableColumn fx:id="colThoiLuong" prefWidth="150.0" text="Thời Lượng Phim" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>