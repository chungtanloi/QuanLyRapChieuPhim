<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox fx:id="filmRoot" spacing="20" styleClass="content-pane" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.FilmController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="QUẢN LÝ THÔNG TIN PHIM" styleClass="page-title">
            <font>
                <Font name="System Bold" size="24"/>
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAddFilm" text="+ Thêm Phim Mới" styleClass="btn-primary" onAction="#handleAddFilm">
            <font>
                <Font size="14"/>
            </font>
        </Button>
    </HBox>
    
    <Separator/>
    
    <!-- Bộ lọc tìm kiếm -->
    <VBox spacing="15" styleClass="filter-box">
        <Label text="BỘ LỌC TÌM KIẾM" styleClass="section-title">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Label>
        
        <GridPane hgap="15" vgap="15">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
            </columnConstraints>
            
            <!-- Tên phim -->
            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Tên phim">
                    <font>
                        <Font size="12"/>
                    </font>
                </Label>
                <TextField fx:id="txtSearchName" promptText="Nhập tên phim..."/>
            </VBox>
            
            <!-- Thể loại -->
            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Thể loại">
                    <font>
                        <Font size="12"/>
                    </font>
                </Label>
                <ComboBox fx:id="cmbGenre" promptText="Tất cả" prefWidth="200" maxWidth="Infinity"/>
            </VBox>
            
            <!-- Phân loại -->
            <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label text="Phân loại">
                    <font>
                        <Font size="12"/>
                    </font>
                </Label>
                <ComboBox fx:id="cmbRating" promptText="Tất cả" prefWidth="200" maxWidth="Infinity"/>
            </VBox>
            
            <!-- Từ ngày -->
            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="Từ ngày">
                    <font>
                        <Font size="12"/>
                    </font>
                </Label>
                <DatePicker fx:id="dpFromDate" promptText="dd/MM/yyyy" prefWidth="200" maxWidth="Infinity"/>
            </VBox>
            
            <!-- Đến ngày -->
            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="Đến ngày">
                    <font>
                        <Font size="12"/>
                    </font>
                </Label>
                <DatePicker fx:id="dpToDate" promptText="dd/MM/yyyy" prefWidth="200" maxWidth="Infinity"/>
            </VBox>
        </GridPane>
        
        <!-- Trạng thái -->
        <HBox spacing="20" alignment="CENTER_LEFT">
            <Label text="Trạng thái:">
                <font>
                    <Font size="12"/>
                </font>
            </Label>
            <CheckBox fx:id="chkShowNow" text="Đang chiếu" selected="true"/>
            <CheckBox fx:id="chkUpcoming" text="Sắp chiếu" selected="true"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnSearch" text="Tìm Kiếm" styleClass="btn-search" onAction="#handleSearch">
                <font>
                    <Font size="13"/>
                </font>
            </Button>
        </HBox>
    </VBox>
    
    <Separator/>
    
    <!-- Thông tin chi tiết phim -->
    <VBox spacing="15" VBox.vgrow="ALWAYS">
        <Label text="THÔNG TIN CHI TIẾT PHIM" styleClass="section-title">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Label>
        
        <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
            <Label text="DANH SÁCH PHIM" styleClass="table-header">
                <font>
                    <Font name="System Bold" size="13"/>
                </font>
                <padding>
                    <Insets top="10" right="15" bottom="10" left="15"/>
                </padding>
            </Label>
            
            <TableView fx:id="tblFilm" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="Mã" prefWidth="60" minWidth="60"/>
                    <TableColumn fx:id="colName" text="Tên Phim" prefWidth="250" minWidth="150"/>
                    <TableColumn fx:id="colDuration" text="Thời Lượng (phút)" prefWidth="130" minWidth="100"/>
                    <TableColumn fx:id="colGenre" text="Thể Loại" prefWidth="150" minWidth="100"/>
                    <TableColumn fx:id="colRating" text="Phân Loại" prefWidth="100" minWidth="80"/>
                    <TableColumn fx:id="colReleaseDate" text="Ngày Khởi Chiếu" prefWidth="150" minWidth="120"/>
                    <TableColumn fx:id="colStatus" text="Trạng Thái" prefWidth="120" minWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
        
        <!-- Action buttons -->
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="btnEdit" text="Sửa" styleClass="btn-edit" onAction="#handleEdit" disable="true">
                <font>
                    <Font size="13"/>
                </font>
            </Button>
            <Button fx:id="btnDelete" text="Xóa" styleClass="btn-delete" onAction="#handleDelete" disable="true">
                <font>
                    <Font size="13"/>
                </font>
            </Button>
            <Button fx:id="btnRefresh" text="Làm mới" styleClass="btn-refresh" onAction="#handleRefresh">
                <font>
                    <Font size="13"/>
                </font>
            </Button>
        </HBox>
    </VBox>
</VBox>