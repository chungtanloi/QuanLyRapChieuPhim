<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.StaffOrderController"
            prefWidth="1400" prefHeight="800"
            style="-fx-background-color: #f4f6f9;">

    <!-- ========== HEADER ========== -->
    <top>
        <HBox spacing="15" style="-fx-background-color: #1f2937;" alignment="CENTER_LEFT">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="🎬 HỆ THỐNG BÁN VÉ (NHÂN VIÊN)"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            
            <Pane HBox.hgrow="ALWAYS"/>
            
            <!-- Nút đăng xuất -->
            <Button fx:id="btnDangXuat" 
                    text="🚪 Đăng xuất"
                    onAction="#onDangXuat"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-size: 14px; -fx-background-radius: 6;"/>
        </HBox>
    </top>

    <!-- ========== NỘI DUNG ========== -->
    <center>
        <HBox spacing="20">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <!-- ========== PANEL 1: PHIM ========== -->
            <VBox spacing="12" prefWidth="450">
                <Label text="Danh sách phim"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill:#1f2937;"/>

                <HBox spacing="10">
                    <TextField fx:id="txtSearch" promptText="Tìm phim..." prefWidth="200"/>
                    <DatePicker fx:id="dpNgayChieu"/>
                </HBox>

                <ComboBox fx:id="cbDinhDang" prefWidth="200"/>

                <ScrollPane fitToWidth="true" prefHeight="700"
                            style="-fx-background-color: transparent;">
                    <content>
                        <TilePane fx:id="tilePhim"
                                  hgap="10" vgap="10"
                                  prefColumns="2"
                                  style="-fx-background-color: transparent;">
                            <padding>
                                <Insets top="5" right="5" bottom="5" left="5"/>
                            </padding>
                        </TilePane>
                    </content>
                </ScrollPane>
            </VBox>

            <!-- ========== PANEL 2: SUẤT + SẢN PHẨM ========== -->
            <VBox spacing="12" prefWidth="350">
                <Label text="Thông tin suất chiếu"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill:#1f2937;"/>

                <Label text="(Chọn phim để hiển thị danh sách suất chiếu)"
                       style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>

                <Separator/>

                <Label text="Chọn sản phẩm / combo:"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <Button text="➕ Thêm sản phẩm / combo"
                        onAction="#openChonSanPham"
                        style="-fx-background-color:#2563eb; -fx-text-fill:white; -fx-padding:10; -fx-background-radius:8;"/>

                <Label text="(Sau khi chọn suất chiếu)" style="-fx-text-fill:#6b7280;"/>

                <Region VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- ========== PANEL 3: HÓA ĐƠN ========== -->
            <VBox spacing="12" prefWidth="400">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Hóa đơn"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill:#1f2937;"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                </HBox>

                <Label text="📌 Nhấp chuột phải vào sản phẩm để xóa"
                       style="-fx-font-size: 11px; -fx-text-fill: #6b7280; -fx-font-style: italic;"/>

                <ListView fx:id="lvHoaDon" prefHeight="550"
                          style="-fx-font-size:15px; -fx-background-color:white;"/>

                <HBox spacing="10">
                    <Label text="Tổng tiền:"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblTong"
                           text="0 đ"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill:#dc2626;"/>
                </HBox>

                <Button text="💵 Thanh toán"
                        fx:id="btnThanhToan"
                        onAction="#onThanhToan"
                        style="-fx-background-color:#16a34a; -fx-padding:15; -fx-font-size:18px; -fx-text-fill:white; -fx-background-radius:8;"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>