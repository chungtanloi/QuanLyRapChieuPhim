<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Customer_mnController"
            prefWidth="950" prefHeight="600">

    <children>

        <!-- Tiêu đề -->
        <Label text="👥 Quản Lý Khách Hàng"
               layoutX="20" layoutY="15"
               style="-fx-font-size:22px; -fx-font-weight:bold;"/>

        <!-- Nút thêm + tìm kiếm -->
        <Button fx:id="btnThem" text="Thêm khách hàng"
                layoutX="20" layoutY="60" onAction="#handleAddCustomer"/>

        <TextField fx:id="txtTimKiemKH" promptText="Tìm theo mã, tên, email, SĐT..."
                   layoutX="200" layoutY="60" prefWidth="500"/>

        <Button fx:id="btnTimKiem" text="Tìm kiếm"
                layoutX="710" layoutY="60" onAction="#handleSearchCustomer"/>

        <!-- Nhãn thống kê -->
        <HBox layoutX="20" layoutY="100" spacing="40">
            <children>
                <Label text="Tổng khách hàng:"/>
                <Label fx:id="totalCustomersLabel" text="0" style="-fx-font-weight:bold;"/>
                <Label text="Hoạt động:"/>
                <Label fx:id="activeCustomersLabel" text="0" style="-fx-font-weight:bold; -fx-text-fill:green;"/>
                <Label text="Ngừng hoạt động:"/>
                <Label fx:id="inactiveCustomersLabel" text="0" style="-fx-font-weight:bold; -fx-text-fill:red;"/>
                <Label text="Tài khoản hoạt động:"/>
                <Label fx:id="activeAccountsLabel" text="0" style="-fx-font-weight:bold;"/>
            </children>
        </HBox>

        <!-- Bảng danh sách -->
        <TableView fx:id="customerTable"
                   layoutX="20" layoutY="140"
                   prefWidth="900" prefHeight="420">
            <columns>
                <TableColumn fx:id="colMaKhachHang" text="Mã KH" prefWidth="70"/>
                <TableColumn fx:id="colHoTen" text="Họ tên" prefWidth="160"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="180"/>
                <TableColumn fx:id="colSoDienThoai" text="SĐT" prefWidth="140"/>
                <TableColumn fx:id="colNgaySinh" text="Ngày sinh" prefWidth="120"/>
                <TableColumn fx:id="colDiemTichLuy" text="Điểm TL" prefWidth="80"/>
                <TableColumn fx:id="colTrangThai" text="Trạng thái" prefWidth="100"/>
                <TableColumn fx:id="colThaoTac" text="Thao tác" prefWidth="150"/>
            </columns>
        </TableView>

    </children>
</AnchorPane>
