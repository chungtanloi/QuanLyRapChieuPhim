<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.LichChieuController">

    <children>
        <VBox spacing="5" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">

            <!-- ================= Thanh công cụ ================= -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-border-color: #cccccc; -fx-border-width: 0 0 1 0; -fx-padding: 5;">
                <children>
                    <Button fx:id="btnThemLichChieu" text="+ Thêm lịch chiếu" />
                    <Button fx:id="btnXemTuanTruoc" text="&lt; Tuần trước" />
                    <Button fx:id="btnXemHomNay" text="Hôm nay" />
                    <Button fx:id="btnXemTuanSau" text="Tuần sau &gt;" />

                    <ComboBox fx:id="cbRapLichChieu" prefWidth="150" promptText="Chọn rạp" />
                    <ComboBox fx:id="cbPhongLichChieu" prefWidth="150" promptText="Chọn phòng" />

                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblTuanHienTai" style="-fx-font-weight:bold;" text="Tuần: 01/01 - 07/01" />
                </children>
            </HBox>

            <!-- ================= Tiêu đề cột ================= -->
            <HBox spacing="0" style="-fx-background-color:#e0e0e0; -fx-border-color:#cccccc; -fx-border-width:0 0 1 0;">
                
                <!-- Phòng -->
                <VBox alignment="CENTER" prefWidth="150.0" style="-fx-border-color:#cccccc; -fx-border-width:0 1 0 0;">
                    <Label style="-fx-font-weight:bold;" text="Phòng" />
                </VBox>

                <!-- 7 ngày -->
                <VBox alignment="CENTER" prefWidth="150" style="-fx-border-color:#cccccc; -fx-border-width:0 1 0 0;">
                    <Label text="Chủ nhật" /><Label fx:id="lblDateMonday" text="10/11" />
                </VBox>

                <VBox alignment="CENTER" prefWidth="150" style="-fx-border-color:#cccccc; -fx-border-width:0 1 0 0;">
                    <Label text="Thứ 2" /><Label fx:id="lblDateTuesday" text="11/11" />
                </VBox>

                <VBox alignment="CENTER" prefWidth="150" style="-fx-border-color:#cccccc; -fx-border-width:0 1 0 0;">
                    <Label text="Thứ 3" /><Label fx:id="lblDateWednesday" text="12/11" />
                </VBox>

                <VBox alignment="CENTER" prefWidth="150" style="-fx-border-color:#cccccc; -fx-border-width:0 1 0 0;">
                    <Label text="Thứ 4" /><Label fx:id="lblDateThursday" text="13/11" />
                </VBox>

                <VBox alignment="CENTER" prefWidth="150" style="-fx-border-color:#cccccc; -fx-border-width:0 1 0 0;">
                    <Label text="Thứ 5" /><Label fx:id="lblDateFriday" text="14/11" />
                </VBox>

                <VBox alignment="CENTER" prefWidth="150" style="-fx-border-color:#cccccc; -fx-border-width:0 1 0 0;">
                    <Label text="Thứ 6" /><Label fx:id="lblDateSaturday" text="15/11" />
                </VBox>

                <VBox alignment="CENTER" prefWidth="150">
                    <Label text="Thứ 7" /><Label fx:id="lblDateSunday" text="16/11" />
                </VBox>
            </HBox>

            <!-- ================= Nội dung lịch chiếu ================= -->
            <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color:white;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="containerLichChieu" spacing="0" />
                </content>
            </ScrollPane>

            <!-- ================= Legend trạng thái ================= -->
            <HBox alignment="CENTER" spacing="20" style="-fx-border-color:#cccccc; -fx-border-width:1 0 0 0; -fx-padding:5;">
                <Label style="-fx-background-color:#4CAF50; -fx-padding:3 8; -fx-text-fill:white;" text="Sắp chiếu" />
                <Label style="-fx-background-color:#2196F3; -fx-padding:3 8; -fx-text-fill:white;" text="Đang chiếu" />
                <Label style="-fx-background-color:#9E9E9E; -fx-padding:3 8; -fx-text-fill:white;" text="Đã chiếu" />
            </HBox>

        </VBox>
    </children>
</AnchorPane>
