<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" styleClass="content-area"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.KhachHangController">

    <!-- Thanh tìm kiếm -->
    <children>
        <HBox spacing="8">
            <children>
                <TextField fx:id="txtTimKhach"
                           onAction="#timKhachHang"
                           promptText="Tìm khách theo tên / SĐT / email…"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="btnTimKhach" onAction="#timKhachHang" text="Tìm" />
                <Button fx:id="btnClearTimKH" text="Xoá" />
                <Separator orientation="VERTICAL" />
                <Button fx:id="btnThemKH" text="Thêm KH" />
            </children>
        </HBox>

        <!-- Bảng khách hàng -->
        <TableView fx:id="tblKhachHang" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colMaKH"   prefWidth="80"  text="Mã" />
                <TableColumn fx:id="colHoTen"  prefWidth="220" text="Tên khách" />
                <TableColumn fx:id="colSDT"    prefWidth="140" text="SĐT" />
                <TableColumn fx:id="colEmail"  prefWidth="220" text="Email" />
                <TableColumn fx:id="colHangTV" prefWidth="110" text="Hạng TV" />
                <TableColumn fx:id="colDiem"   prefWidth="90"  text="Điểm" />
            </columns>
        </TableView>
    </children>

    <padding>
        <Insets bottom="12" left="12" right="12" top="12" />
    </padding>
</VBox>
