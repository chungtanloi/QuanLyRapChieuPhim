<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.StatisticsController">
    <top>
        <!-- Header với bộ lọc -->
        <VBox spacing="15" style="-fx-background-color: #ffffff; -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="THỐNG KÊ BÁO CÁO" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #d32f2f;" />
            </HBox>
            
            <!-- Bộ lọc -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Từ ngày:" style="-fx-font-size: 14;" />
                <DatePicker fx:id="fromDatePicker" prefWidth="150" promptText="Chọn ngày" />
                
                <Label text="Đến ngày:" style="-fx-font-size: 14;" />
                <DatePicker fx:id="toDatePicker" prefWidth="150" promptText="Chọn ngày" />
                
                <Label text="Loại thống kê:" style="-fx-font-size: 14;" />
                <ComboBox fx:id="statisticTypeComboBox" prefWidth="180" promptText="Chọn loại">
                </ComboBox>
                
                <Button fx:id="filterButton" text="Lọc dữ liệu" onAction="#handleFilter" 
                        style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-size: 14; -fx-padding: 8 20;" />
                
                <Button fx:id="exportButton" text="Xuất báo cáo" onAction="#handleExport"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14; -fx-padding: 8 20;" />
            </HBox>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: #f5f5f5;">
            
            <!-- Thẻ thống kê tổng quan -->
            <GridPane hgap="20" vgap="20">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="25" />
                </columnConstraints>
                
                <!-- Card 1: Doanh thu -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" GridPane.columnIndex="0">
                    <Label text="TỔNG DOANH THU" style="-fx-font-size: 12; -fx-text-fill: #666;" />
                    <Label fx:id="totalRevenueLabel" text="0 VNĐ" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #4CAF50;">
                        <padding><Insets top="10" /></padding>
                    </Label>
                    <Label fx:id="revenueChangeLabel" text="↑ 0% so với kỳ trước" style="-fx-font-size: 11; -fx-text-fill: #4CAF50;">
                        <padding><Insets top="5" /></padding>
                    </Label>
                </VBox>
                
                <!-- Card 2: Vé bán -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" GridPane.columnIndex="1">
                    <Label text="TỔNG VÉ BÁN" style="-fx-font-size: 12; -fx-text-fill: #666;" />
                    <Label fx:id="totalTicketsLabel" text="0 vé" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2196F3;">
                        <padding><Insets top="10" /></padding>
                    </Label>
                    <Label fx:id="ticketsChangeLabel" text="↑ 0% so với kỳ trước" style="-fx-font-size: 11; -fx-text-fill: #2196F3;">
                        <padding><Insets top="5" /></padding>
                    </Label>
                </VBox>
                
                <!-- Card 3: Khách hàng -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" GridPane.columnIndex="2">
                    <Label text="KHÁCH HÀNG MỚI" style="-fx-font-size: 12; -fx-text-fill: #666;" />
                    <Label fx:id="newCustomersLabel" text="0 người" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #FF9800;">
                        <padding><Insets top="10" /></padding>
                    </Label>
                    <Label fx:id="customersChangeLabel" text="↑ 0% so với kỳ trước" style="-fx-font-size: 11; -fx-text-fill: #FF9800;">
                        <padding><Insets top="5" /></padding>
                    </Label>
                </VBox>
                
                <!-- Card 4: Suất chiếu -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" GridPane.columnIndex="3">
                    <Label text="SUẤT CHIẾU" style="-fx-font-size: 12; -fx-text-fill: #666;" />
                    <Label fx:id="totalScreeningsLabel" text="0 suất" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #9C27B0;">
                        <padding><Insets top="10" /></padding>
                    </Label>
                    <Label fx:id="screeningsChangeLabel" text="↑ 0% so với kỳ trước" style="-fx-font-size: 11; -fx-text-fill: #9C27B0;">
                        <padding><Insets top="5" /></padding>
                    </Label>
                </VBox>
            </GridPane>
            
            <!-- Biểu đồ -->
            <GridPane hgap="20" vgap="20">
                <columnConstraints>
                    <ColumnConstraints percentWidth="60" />
                    <ColumnConstraints percentWidth="40" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="300" />
                    <RowConstraints minHeight="300" />
                </rowConstraints>
                
                <!-- Biểu đồ doanh thu theo thời gian -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" 
                      GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Doanh thu theo thời gian" style="-fx-font-size: 16; -fx-font-weight: bold;">
                        <padding><Insets bottom="10" /></padding>
                    </Label>
                    <LineChart fx:id="revenueChart" legendVisible="false" VBox.vgrow="ALWAYS">
                        <xAxis>
                            <CategoryAxis label="Thời gian" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Doanh thu (VNĐ)" />
                        </yAxis>
                    </LineChart>
                </VBox>
                
                <!-- Biểu đồ phân bố doanh thu -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" 
                      GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Phân bố doanh thu" style="-fx-font-size: 16; -fx-font-weight: bold;">
                        <padding><Insets bottom="10" /></padding>
                    </Label>
                    <PieChart fx:id="revenuePieChart" legendVisible="true" VBox.vgrow="ALWAYS" />
                </VBox>
                
                <!-- Biểu đồ top phim -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" 
                      GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                    <Label text="Top 10 phim có doanh thu cao nhất" style="-fx-font-size: 16; -fx-font-weight: bold;">
                        <padding><Insets bottom="10" /></padding>
                    </Label>
                    <BarChart fx:id="topMoviesChart" legendVisible="false" VBox.vgrow="ALWAYS">
                        <xAxis>
                            <CategoryAxis label="Phim" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Doanh thu (VNĐ)" />
                        </yAxis>
                    </BarChart>
                </VBox>
            </GridPane>
            
            <!-- Bảng chi tiết -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <Label text="Chi tiết thống kê" style="-fx-font-size: 16; -fx-font-weight: bold;">
                    <padding><Insets bottom="10" /></padding>
                </Label>
                <TableView fx:id="detailTableView" VBox.vgrow="ALWAYS" prefHeight="300">
                    <columns>
                        <TableColumn fx:id="dateColumn" text="Ngày" prefWidth="120" />
                        <TableColumn fx:id="movieColumn" text="Phim" prefWidth="200" />
                        <TableColumn fx:id="screeningsColumn" text="Suất chiếu" prefWidth="100" />
                        <TableColumn fx:id="ticketsColumn" text="Vé bán" prefWidth="100" />
                        <TableColumn fx:id="revenueColumn" text="Doanh thu (VNĐ)" prefWidth="150" />
                        <TableColumn fx:id="occupancyColumn" text="Tỷ lệ lấp đầy" prefWidth="120" />
                    </columns>
                </TableView>
            </VBox>
            
        </VBox>
    </center>
</BorderPane>