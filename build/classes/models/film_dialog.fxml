<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" styleClass="dialog-pane" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.FilmDialogController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <!-- Header -->
    <Label fx:id="lblTitle" text="THÊM PHIM MỚI" styleClass="dialog-title">
        <font>
            <Font name="System Bold" size="18"/>
        </font>
    </Label>
    
    <Separator/>
    
    <!-- Form -->
    <GridPane hgap="15" vgap="15">
        <columnConstraints>
            <ColumnConstraints percentWidth="30"/>
            <ColumnConstraints percentWidth="70"/>
        </columnConstraints>
        
        <!-- Tên phim -->
        <Label text="Tên phim: *" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <font>
                <Font size="13"/>
            </font>
        </Label>
        <TextField fx:id="txtTenPhim" promptText="Nhập tên phim..." GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        
        <!-- Thời lượng -->
        <Label text="Thời lượng (phút): *" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <font>
                <Font size="13"/>
            </font>
        </Label>
        <TextField fx:id="txtThoiLuong" promptText="VD: 120" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        
        <!-- Phân loại -->
        <Label text="Phân loại: *" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <font>
                <Font size="13"/>
            </font>
        </Label>
        <ComboBox fx:id="cmbPhanLoai" prefWidth="200" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        
        <!-- Ngày phát hành -->
        <Label text="Ngày phát hành: *" GridPane.columnIndex="0" GridPane.rowIndex="3">
            <font>
                <Font size="13"/>
            </font>
        </Label>
        <DatePicker fx:id="dpNgayPhatHanh" promptText="dd/MM/yyyy" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        
        <!-- Thể loại -->
        <Label text="Thể loại:" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.valignment="TOP">
            <font>
                <Font size="13"/>
            </font>
            <padding>
                <Insets top="5"/>
            </padding>
        </Label>
        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="4">
            <ScrollPane fitToWidth="true" prefHeight="120" maxHeight="120">
                <VBox fx:id="vboxTheLoai" spacing="5">
                    <padding>
                        <Insets top="5" right="5" bottom="5" left="5"/>
                    </padding>
                </VBox>
            </ScrollPane>
        </VBox>
        
        <!-- Poster URL -->
        <Label text="Poster URL:" GridPane.columnIndex="0" GridPane.rowIndex="5">
            <font>
                <Font size="13"/>
            </font>
        </Label>
        <TextField fx:id="txtPosterUrl" promptText="https://..." GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        
        <!-- Mô tả -->
        <Label text="Mô tả:" GridPane.columnIndex="0" GridPane.rowIndex="6" GridPane.valignment="TOP">
            <font>
                <Font size="13"/>
            </font>
            <padding>
                <Insets top="5"/>
            </padding>
        </Label>
        <TextArea fx:id="txtMoTa" promptText="Nhập mô tả phim..." prefRowCount="4" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
    </GridPane>
    
    <Label text="* Trường bắt buộc" styleClass="required-note">
        <font>
            <Font size="11" />
        </font>
    </Label>
    
    <Separator/>
    
    <!-- Action buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnSave" text="Lưu" styleClass="btn-primary" onAction="#handleSave" prefWidth="100">
            <font>
                <Font size="13"/>
            </font>
        </Button>
        <Button fx:id="btnCancel" text="Hủy" styleClass="btn-secondary" onAction="#handleCancel" prefWidth="100">
            <font>
                <Font size="13"/>
            </font>
        </Button>
    </HBox>
</VBox>